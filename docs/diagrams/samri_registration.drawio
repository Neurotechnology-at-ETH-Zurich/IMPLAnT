        <mxCell id="pe2" value="get_s_scan &#183; Workflow.run(MultiProc, n_procs=N)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0E8C89;strokeWidth=1.75;endArrow=block;endFill=1;fontColor=#57678C;fontSize=9.5;" edge="1" parent="1" source="worker" target="chain1">
