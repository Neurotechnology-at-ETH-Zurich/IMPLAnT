        <mxCell id="pe7" style="edgeStyle=none;html=1;strokeColor=#8FA1C4;strokeWidth=1;dashed=1;endArrow=none;startArrow=none;" edge="1" parent="1" source="notecard" target="worker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="footnote" value="For the common case (1 matching scan) these three ANTs steps run strictly sequentially &#8212; one subprocess active at a time; the pool only helps when &gt;1 scan matches.&lt;br&gt;Each job gets its own fresh SamriWorker instance &#8212; FETCH and REGISTER never run at the same time. n_procs is the &quot;Threads&quot; spinbox (1&#8211;8) &#183; on OOM, main_window.py retries once at N/2." style="text;html=1;align=center;verticalAlign=middle;fontColor=#57678C;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="392" width="960" height="34" as="geometry" />
        </mxCell>
      </root>
