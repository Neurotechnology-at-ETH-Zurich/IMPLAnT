        <mxCell id="pe5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8FA1C4;strokeWidth=1.25;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="chain1" target="condbox">
