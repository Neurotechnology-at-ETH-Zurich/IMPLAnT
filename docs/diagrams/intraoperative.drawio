<mxfile host="app.diagrams.net" agent="claude-code" version="24.7.0" type="device">

  <diagram id="page1entry" name="1 - Entry &amp; controller lifecycle">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="init" value="&lt;b&gt;initialize_surgery()&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E2E9F2;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="30" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dlg" value="&lt;b&gt;LoadSurgeryPlan dialog&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57678C&quot; style=&quot;font-size:9px&quot;&gt;pick a saved Trajectory Report PDF&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="230" y="30" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="json" value="&lt;b&gt;trajectory_planning_data.json&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57678C&quot; style=&quot;font-size:9px&quot;&gt;PdfReader(path).attachments[...][0]&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8C89;strokeWidth=2;fontColor=#12213D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="490" y="30" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="loadplan" value="&lt;b&gt;SurgeryController.load_plan()&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57678C&quot; style=&quot;font-size:9px&quot;&gt;via BusyOverlay.run(...)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="780" y="30" width="280" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8FA1C4;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="init" target="dlg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0E8C89;strokeWidth=1.75;endArrow=block;endFill=1;" edge="1" parent="1" source="dlg" target="json"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8FA1C4;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="json" target="loadplan"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="restore" value="main_window.py:451 (session restore) also calls the SAME load_plan directly" style="text;html=1;align=left;verticalAlign=middle;fontColor=#57678C;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="780" y="85" width="300" height="20" as="geometry" />
        </mxCell>

        <mxCell id="lifecycle" value="&lt;b&gt;SurgeryController&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0E8C89&quot; style=&quot;font-size:9px&quot;&gt;created ONCE, MainWindow.__init__ — lives&lt;br&gt;for the app's WHOLE session&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8C89;strokeWidth=2;fontColor=#12213D;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tpcompare" value="&lt;b&gt;TrajectoryPlanningMri&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57678C&quot; style=&quot;font-size:9px&quot;&gt;(for comparison) — only exists while a plan&lt;br&gt;is actively being edited&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E2E9F2;strokeColor=#8FA1C4;strokeWidth=1.5;dashed=1;fontColor=#12213D;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="150" width="320" height="90" as="geometry" />
        </mxCell>

        <mxCell id="lazyui" value="&lt;b&gt;.ui&lt;/b&gt; (live property, not cached)&lt;br&gt;&lt;b&gt;.mri_preview / .axial_view&lt;/b&gt; (lazy, rebuilt&lt;br&gt;on container-widget identity change)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=10.5;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="protects against" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0E8C89;strokeWidth=1.75;endArrow=block;endFill=1;fontColor=#0E8C89;fontSize=9;" edge="1" parent="1" source="lazyui" target="restartgui"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="restartgui" value="&lt;b&gt;MainWindow.restart_gui&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57678C&quot; style=&quot;font-size:9px&quot;&gt;replaces self.MW.ui with a brand-new&lt;br&gt;Ui_MainWindow() — old widgets torn down&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#C4D0E3;strokeWidth=1.25;fontColor=#12213D;fontSize=10.5;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="270" width="320" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page2reprojection" name="2 - Reprojection math">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="380" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="plan" value="&lt;b&gt;Plan's own frame&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57678C&quot; style=&quot;font-size:9px&quot;&gt;bregma-relative, anatomical mm&lt;br&gt;(ap_mm, rl_mm per shank, from&lt;br&gt;FileOutput.compute())&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E2E9F2;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="manip" value="&lt;b&gt;Manipulator's frame&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57678C&quot; style=&quot;font-size:9px&quot;&gt;null-point-relative, dial mm&lt;br&gt;(measured bregma_null_mm,&lt;br&gt;lambda_null_mm)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E2E9F2;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="760" y="40" width="300" height="110" as="geometry" />
        </mxCell>

        <mxCell id="fwd" value="&lt;b&gt;reproject_target_to_null&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;scale = |measured B-L| / |planned B-L|&lt;br&gt;target = bregma_null + scale &#215; (ap&#183;bl_axis + rl&#183;x_axis)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8C89;strokeWidth=2;fontColor=#12213D;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="400" y="30" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="inv" value="&lt;b&gt;null_point_ap_rl&lt;/b&gt; (inverse)&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;where does dial-(0,0) land in the&lt;br&gt;plan's own bregma-relative frame?&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="400" y="100" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0E8C89;strokeWidth=1.75;endArrow=block;endFill=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="plan" target="fwd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0E8C89;strokeWidth=1.75;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fwd" target="manip"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8FA1C4;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="manip" target="inv"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8FA1C4;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="inv" target="plan"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="unchanged" value="&lt;b&gt;Carried over UNCHANGED (no correction path exists):&lt;/b&gt; roll_deg, pitch_deg, depth_mm — no intraoperative DV/vertical measurement exists any more to re-level them with" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#C4D0E3;strokeWidth=1.25;fontColor=#57678C;fontSize=10;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="1020" height="50" as="geometry" />
        </mxCell>
        <mxCell id="usedby" value="refresh_surgery_summary uses the forward direction for the live summary table; update_null_point (skull photo) uses the inverse to place the null-point marker." style="text;html=1;align=left;verticalAlign=middle;fontColor=#57678C;fontSize=9.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="1020" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page3views" name="3 - Two reference views">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="photo" value="&lt;b&gt;Skull-photo view&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;buttons_gui_surgery.py&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#57678C&quot; style=&quot;font-size:9px&quot;&gt;fixed generic rat-skull photo, hand-calibrated&lt;br&gt;bregma/lambda pixels; shank markers via a&lt;br&gt;similarity transform (scale+rotation only,&lt;br&gt;determinant -1 — a reflection)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2E9F2;strokeColor=#C4D0E3;strokeWidth=1.25;fontColor=#12213D;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="380" height="180" as="geometry" />
        </mxCell>

        <mxCell id="shared" value="&lt;b&gt;build_skull_reference_scene()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;SAME drawing code, not two implementations&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8C89;strokeWidth=2;fontColor=#12213D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="470" y="70" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pdfcover" value="&lt;b&gt;Trajectory Planning PDF&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;file_input_output.py::_cover_page&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="740" y="70" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0E8C89;strokeWidth=1.75;endArrow=block;endFill=1;" edge="1" parent="1" source="photo" target="shared"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0E8C89;strokeWidth=1.75;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="shared" target="pdfcover"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="preview" value="&lt;b&gt;3D MRI preview&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;mri_preview.py::SurgeryMRIPreview&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#57678C&quot; style=&quot;font-size:9px&quot;&gt;static, read-only; locates files by naming&lt;br&gt;convention, never regenerates them&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2E9F2;strokeColor=#C4D0E3;strokeWidth=1.25;fontColor=#12213D;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="warped" value="&lt;b&gt;atlas-warped shell&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px&quot;&gt;if output_Composite.h5 found:&lt;br&gt;shape from atlas mask, warped;&lt;br&gt;color from real MRI intensity&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8C89;strokeWidth=2;fontColor=#12213D;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="470" y="230" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="otsu" value="&lt;b&gt;Otsu fallback&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px&quot;&gt;no registration found:&lt;br&gt;segment raw MRI directly&lt;br&gt;(less faithful, but the only option)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="470" y="320" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="found" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0E8C89;strokeWidth=1.75;endArrow=block;endFill=1;fontColor=#0E8C89;fontSize=9;" edge="1" parent="1" source="preview" target="warped"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="not found" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8FA1C4;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;fontColor=#57678C;fontSize=9;" edge="1" parent="1" source="preview" target="otsu"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page4boundary" name="4 - Consumers &amp; live-correction boundary">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="composite" value="&lt;b&gt;output_Composite.h5&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57678C&quot; style=&quot;font-size:9px&quot;&gt;SAMRI's atlas registration transform&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8C89;strokeWidth=2;fontColor=#12213D;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="20" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;Trajectory Planning&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;warp_red_areas — warps a painted&lt;br&gt;forbidden-area mask MRI&#8594;atlas&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E2E9F2;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;During Surgery&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;SurgeryMRIPreview — warps the atlas's&lt;br&gt;brain mask atlas&#8594;MRI for the 3D shell&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E2E9F2;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="780" y="130" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0E8C89;strokeWidth=1.75;endArrow=none;startArrow=block;startFill=1;" edge="1" parent="1" source="composite" target="c1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0E8C89;strokeWidth=1.75;endArrow=block;endFill=1;" edge="1" parent="1" source="composite" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="note1" value="Two independent, real, optional consumers app-wide — both read-only, opposite warp direction" style="text;html=1;align=center;verticalAlign=middle;fontColor=#57678C;fontSize=9.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="1000" height="20" as="geometry" />
        </mxCell>

        <mxCell id="hdr" value="What corrects live from measured bregma/lambda, vs. what always shows the original plan" style="text;html=1;align=left;verticalAlign=middle;fontColor=#57678C;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="700" height="20" as="geometry" />
        </mxCell>

        <mxCell id="v1" value="&lt;b&gt;Summary table&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8C89;strokeWidth=2;fontColor=#12213D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="v1b" value="YES — live" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#0E8C89;strokeColor=none;fontColor=#FFFFFF;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="90" y="330" width="140" height="22" as="geometry" />
        </mxCell>

        <mxCell id="v2" value="&lt;b&gt;Skull-photo null-point marker&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8C89;strokeWidth=2;fontColor=#12213D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="320" y="270" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="v2b" value="YES — live" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#0E8C89;strokeColor=none;fontColor=#FFFFFF;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="390" y="330" width="140" height="22" as="geometry" />
        </mxCell>

        <mxCell id="v3" value="&lt;b&gt;3D MRI preview&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C1393E;strokeWidth=2;fontColor=#12213D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="640" y="270" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="v3b" value="NO — always the original plan" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#C1393E;strokeColor=none;fontColor=#FFFFFF;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="660" y="330" width="240" height="22" as="geometry" />
        </mxCell>

        <mxCell id="reason" value="Reason: the manipulator's null point lives in a physical frame with no fiducial tying it to a location in the scan — the correction has nowhere to go in image space. Not a missing feature; a stated boundary of what the math can express." style="text;html=1;align=left;verticalAlign=middle;fontColor=#57678C;fontSize=9.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="370" width="1020" height="34" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
