<mxfile host="app.diagrams.net" agent="claude-code" version="24.7.0" type="device">

  <diagram id="page1entry" name="1 - Entry &amp; MRI-space hierarchy">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="480" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="gate" value="&lt;b&gt;initialize_trajectory_planning()&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57678C&quot; style=&quot;font-size:9px&quot;&gt;requires output_Composite.h5 to exist&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E2E9F2;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="30" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fileinput" value="&lt;b&gt;FileInput dialog&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57678C&quot; style=&quot;font-size:9px&quot;&gt;&#8594; (main_file, second_file, spacing_mm)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="290" y="30" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="finish" value="&lt;b&gt;finish_trajectory_work()&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57678C&quot; style=&quot;font-size:9px&quot;&gt;resample (reuses SAMRI's 25&#181;m convention&lt;br&gt;if spacing==25&#181;m) &#8594; load into main viewer&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="560" y="30" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tpmri" value="&lt;b&gt;TrajectoryPlanningMri(...)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0E8C89&quot; style=&quot;font-size:9px&quot;&gt;the class that ACTUALLY runs&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8C89;strokeWidth=2;fontColor=#12213D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="880" y="30" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8FA1C4;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="gate" target="fileinput"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8FA1C4;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="fileinput" target="finish"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0E8C89;strokeWidth=1.75;endArrow=block;endFill=1;" edge="1" parent="1" source="finish" target="tpmri"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="hdr" value="TWO CLASS HIERARCHIES — one is never instantiated, the other is what actually runs (main_window.py:1101)" style="text;html=1;align=left;verticalAlign=middle;fontColor=#57678C;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="120" width="900" height="20" as="geometry" />
        </mxCell>

        <mxCell id="base" value="&lt;b&gt;TrajectoryPlanning&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;(CoordTransform, Rendering, TpRegistration,&lt;br&gt;ElecGeometry, ShankRendering, DfxGeometry)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#57678C&quot; style=&quot;font-size:9px&quot;&gt;NEVER directly instantiated anywhere in the repo&lt;br&gt;(confirmed by grep) — swaps display to the ATLAS&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2E9F2;strokeColor=#8FA1C4;strokeWidth=1.5;dashed=1;fontColor=#12213D;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="150" width="420" height="180" as="geometry" />
        </mxCell>
        <mxCell id="mri" value="&lt;b&gt;TrajectoryPlanningMri&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;(RenderingMri, TpRegistrationMri, ElecGeometryMri,&lt;br&gt;ShankRenderingMri, TrajectoryPlanning)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#0E8C89&quot; style=&quot;font-size:9px&quot;&gt;What main_window.py actually constructs — keeps&lt;br&gt;the subject's own MRI displayed for the WHOLE&lt;br&gt;session; atlas labels scattered onto the MRI grid&lt;br&gt;as a colored overlay (build_mri_label_overlay)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8C89;strokeWidth=2;fontColor=#12213D;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="150" width="420" height="180" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="MRI-space mixins placed FIRST in the base list —&#10;C3 MRO resolves overridden methods to these,&#10;everything else falls through to TrajectoryPlanning unchanged" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0E8C89;strokeWidth=1.75;endArrow=block;endFill=1;fontColor=#0E8C89;fontSize=9;fontStyle=1;" edge="1" parent="1" source="base" target="mri"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="overridebox" value="&lt;b&gt;Overridden (display-dependent):&lt;/b&gt;&lt;br&gt;do_get_shank_line, warp_red_areas (&#8594; no-op),&lt;br&gt;draw_atlas_reference_points, reload_atlas_view,&lt;br&gt;compute_shank_reference_angle, draw_electrode_line&lt;br&gt;&lt;br&gt;&lt;b&gt;NEW in MRI-space only:&lt;/b&gt; misalignment correction&lt;br&gt;dial, oblique coronal/sagittal views&lt;br&gt;&lt;br&gt;&lt;b&gt;Inherited unchanged:&lt;/b&gt; register_to_main_img,&lt;br&gt;get_shank_line, init_page30_mirror, paint_red_areas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2E9F2;strokeColor=#C4D0E3;strokeWidth=1.25;fontColor=#12213D;fontSize=10;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="960" y="150" width="220" height="180" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

