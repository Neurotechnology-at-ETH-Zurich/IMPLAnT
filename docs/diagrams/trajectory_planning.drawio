        </mxCell>
        <mxCell id="dock3d" value="&lt;b&gt;TrajectoryPlanning3DWindow&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57678C&quot; style=&quot;font-size:9px&quot;&gt;PyVista &#183; QDockWidget, opened on demand&lt;br&gt;(open_3d_window), reused after &#8212; not modal,&lt;br&gt;not a separate process&lt;br&gt;LIVE interactive shank nudging&lt;br&gt;(_nudge_shank, QTimer-coalesced)&lt;br&gt;mesh rebuild via BusyOverlay.run()&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8C89;strokeWidth=2;fontColor=#12213D;fontSize=11;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
