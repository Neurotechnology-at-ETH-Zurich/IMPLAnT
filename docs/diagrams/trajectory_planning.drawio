  <diagram id="page4registration" name="4 - Registration touchpoints">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="360" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="hdr" value="Two things both called &quot;registration&quot; in this one screen — easy to confuse, functionally unrelated" style="text;html=1;align=left;verticalAlign=middle;fontColor=#57678C;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="800" height="20" as="geometry" />
        </mxCell>

        <mxCell id="reg" value="&lt;b&gt;register_to_main_img&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;TpRegistration &#8594; core.registration.Registration&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#57678C&quot; style=&quot;font-size:9px&quot;&gt;fires when a 2nd/comparison file is supplied&lt;br&gt;&#8594; transformation-ind_M-to-ind_N.txt&lt;br&gt;&#8594; never reads/writes output_Composite.h5&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2E9F2;strokeColor=#C4D0E3;strokeWidth=1.25;fontColor=#12213D;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="420" height="220" as="geometry" />
        </mxCell>
        <mxCell id="regbadge" value="unrelated to SAMRI" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#8FA1C4;strokeColor=none;fontColor=#FFFFFF;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="200" height="24" as="geometry" />
        </mxCell>

        <mxCell id="warp" value="&lt;b&gt;warp_red_areas(transform_path)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;TpRegistration (base/atlas-space) &#8594; ants.apply_transforms&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#57678C&quot; style=&quot;font-size:9px&quot;&gt;fires after painting forbidden areas&lt;br&gt;(reuses 3D Tools Paintbrush, red_only=True)&lt;br&gt;&#8594; GENUINELY applies output_Composite.h5&lt;br&gt;(in-process ANTsPy, nearest-neighbor)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2E9F2;strokeColor=#0E8C89;strokeWidth=2;fontColor=#12213D;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="50" width="420" height="220" as="geometry" />
        </mxCell>
        <mxCell id="warpbadge" value="real SAMRI transform consumer" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#0E8C89;strokeColor=none;fontColor=#FFFFFF;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="560" y="230" width="220" height="24" as="geometry" />
        </mxCell>

        <mxCell id="mrinote" value="TpRegistrationMri's warp_red_areas is a no-op passthrough — the painted mask is already MRI-space, so nothing needs warping; transform_path is accepted-and-ignored just to keep the same call signature." style="text;html=1;align=left;verticalAlign=middle;fontColor=#57678C;fontSize=9.5;" vertex="1" parent="1">
          <mxGeometry x="540" y="280" width="420" height="50" as="geometry" />
