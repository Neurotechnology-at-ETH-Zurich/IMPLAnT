        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8FA1C4;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="live" target="dock3d"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="nolink" value="no import either direction — independent, both read the same live state" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C1393E;strokeWidth=1.5;dashed=1;endArrow=none;startArrow=none;fontColor=#C1393E;fontSize=9;fontStyle=1;" edge="1" parent="1" source="v3d" target="dock3d"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="235"/></Array></mxGeometry></mxCell>

        <mxCell id="shared2" value="Both warp atlas-shaped mesh vertices into true MRI space via the SAME atlas_points_to_mri_indices technique (coord_transform.py) — mesh cell data (region indices) stays untouched, only vertex positions move" style="text;html=1;align=left;verticalAlign=middle;fontColor=#57678C;fontSize=9.5;" vertex="1" parent="1">
          <mxGeometry x="80" y="335" width="840" height="34" as="geometry" />
