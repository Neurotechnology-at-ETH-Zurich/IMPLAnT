          <mxGeometry x="380" y="20" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="v3d" value="&lt;b&gt;Visualisation3D&lt;/b&gt; (&#8594; VisualisationMri)&lt;br&gt;&lt;font color=&quot;#57678C&quot; style=&quot;font-size:9px&quot;&gt;PyVista &#183; always-visible, in-panel&lt;br&gt;3 QtInteractor plotters (co/sa/ax),&lt;br&gt;clipping plane = looks like 2D slice&lt;br&gt;ThreadPoolExecutor(3) for parallel LOAD&lt;br&gt;only — still blocks caller, not GUI-async&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8C89;strokeWidth=2;fontColor=#12213D;fontSize=11;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
