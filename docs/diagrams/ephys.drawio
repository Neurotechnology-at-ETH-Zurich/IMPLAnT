        <mxCell id="fourd" value="&lt;b&gt;4D Visualisation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px&quot;&gt;MRID tags labeling &#8594; heatmap&lt;br&gt;&#8594; &lt;file&gt;-&lt;roi&gt;-heatmap.nii.gz&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E2E9F2;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
