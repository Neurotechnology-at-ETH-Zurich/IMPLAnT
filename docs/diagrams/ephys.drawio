      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="mw" value="&lt;b&gt;main_window.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&quot;Open Ephys Data&quot;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E2E9F2;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
