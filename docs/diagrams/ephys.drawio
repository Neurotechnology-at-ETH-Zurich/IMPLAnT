        </mxCell>
        <mxCell id="init" value="&lt;b&gt;InitEphys(MW, file_name)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;constructed ONCE — main_window.py:504&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8C89;strokeWidth=2;fontColor=#12213D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="280" y="30" width="280" height="50" as="geometry" />
