        </mxCell>
        <mxCell id="eloc" value="&lt;b&gt;Electrode Localization&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px&quot;&gt;Gaussian fit + chmap&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8C89;strokeWidth=2;fontColor=#12213D;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="560" y="40" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ephys" value="&lt;b&gt;Ephys session load&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px&quot;&gt;InitEphys / MRIDInfo&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8C89;strokeWidth=2;fontColor=#12213D;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="840" y="40" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0E8C89;strokeWidth=1.75;endArrow=block;endFill=1;" edge="1" parent="1" source="samri" target="eloc">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="160"/><mxPoint x="670" y="160"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0E8C89;strokeWidth=1.75;endArrow=block;endFill=1;" edge="1" parent="1" source="fourd" target="eloc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="analysed/&lt;tag&gt;/gaussian_centers_3D.npy&#10;+ channel_atlas_coordinates.xlsx" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0E8C89;strokeWidth=1.75;endArrow=block;endFill=1;fontColor=#0E8C89;fontSize=9;" edge="1" parent="1" source="eloc" target="ephys"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="loopnote" value="A real closed loop spanning THREE separate docs in this series: 4D labeling produces the heatmap Electrode Localization fits Gaussian centers from; Electrode Localization's outputs are what Ephys session load reads back to identify which shank a recording belongs to. SAMRI's registration output feeds Electrode Localization independently, via two different files (transformation-*.txt and the correspondence-array pair)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#C4D0E3;strokeWidth=1.25;fontColor=#57678C;fontSize=10;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="200" width="1080" height="90" as="geometry" />
        </mxCell>

        <mxCell id="docs" value="SAMRI doc &#8594; 4D doc &#8594; (this doc, Electrode Localization + Ephys) — the only place in this whole series where three separately-delivered architecture packages meet at real, file-based data dependencies." style="text;html=1;align=left;verticalAlign=middle;fontColor=#8FA1C4;fontSize=9.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="300" width="1080" height="30" as="geometry" />
        </mxCell>
