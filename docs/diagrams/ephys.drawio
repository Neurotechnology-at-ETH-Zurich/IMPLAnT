        <mxCell id="note" value="TWO independent, real dependencies on SAMRI's registration output exist in this one class — a change to either format needs checking against Electrode Localization specifically." style="text;html=1;align=left;verticalAlign=middle;fontColor=#0E8C89;fontSize=9.5;fontStyle=1;" vertex="1" parent="1">
