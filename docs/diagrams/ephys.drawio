        <mxCell id="rec" value="&lt;b&gt;EphysRecording&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px&quot;&gt;.dat via neo.io.NeuroScopeIO,&lt;br&gt;.xml channel groups, .lfp memmap&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="130" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="digi" value="&lt;b&gt;DigitalInFile&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px&quot;&gt;digitalin.dat — camera/LED TTL&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="280" y="130" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="mridinfo" value="&lt;b&gt;MRIDInfo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px&quot;&gt;reads analysed/&lt;tag&gt;/gaussian_centers_3D.npy&lt;br&gt;+ channel_atlas_coordinates.xlsx&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8C89;strokeWidth=2;fontColor=#12213D;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="540" y="130" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8FA1C4;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="init" target="rec">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="105"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8FA1C4;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="init" target="digi"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0E8C89;strokeWidth=1.75;endArrow=block;endFill=1;" edge="1" parent="1" source="init" target="mridinfo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="note1" value="Real cross-subsystem dependency: MRIDInfo reads back exactly what Electrode Localization (sheet 4) writes, to identify which shank this recording is." style="text;html=1;align=left;verticalAlign=middle;fontColor=#0E8C89;fontSize=9;fontStyle=1;" vertex="1" parent="1">
