<mxfile host="app.diagrams.net" agent="claude-code" version="24.7.0" type="device">

  <diagram id="page1structure" name="1 - Viewer structure &amp; data model">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="fileloader" value="&lt;b&gt;FileLoader.initialize_file()&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E2E9F2;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="30" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="page4d" value="&lt;b&gt;page_4Ddata0&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0E8C89&quot; style=&quot;font-size:9px&quot;&gt;3 VTK panels — each a DIFFERENT TIMEPOINT&lt;br&gt;of the SAME acquisition (not 3 views)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8C89;strokeWidth=2;fontColor=#12213D;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="290" y="30" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="is_4d == True" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0E8C89;strokeWidth=1.75;endArrow=block;endFill=1;fontColor=#0E8C89;fontSize=9;" edge="1" parent="1" source="fileloader" target="page4d"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="array4d" value="&lt;b&gt;MRIVolume.array_4d&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57678C&quot; style=&quot;font-size:9px&quot;&gt;full time series, shape [time, z, y, x]&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="150" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tswap" value="&lt;b&gt;ImageLayer.timestamp4D_changed&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57678C&quot; style=&quot;font-size:9px&quot;&gt;volume[image_index] = array_4d[index,:,:,:].copy()&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="350" y="150" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="imagelayer" value="&lt;b&gt;ImageLayer&lt;/b&gt; — SAME class as page_3D&lt;br&gt;&lt;font color=&quot;#0E8C89&quot; style=&quot;font-size:9px&quot;&gt;numpy&#8594;VTK pipeline reused UNMODIFIED&lt;br&gt;(setup_vtk, vtkImageReslice, vtkImageActor+LUT)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8C89;strokeWidth=2;fontColor=#12213D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="740" y="150" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8FA1C4;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="array4d" target="tswap"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0E8C89;strokeWidth=1.75;endArrow=block;endFill=1;" edge="1" parent="1" source="tswap" target="imagelayer"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8FA1C4;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="page4d" target="array4d"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note" value="MRIVolume.slices is pre-seeded with just 3 initial timepoints (timestamp4D = [0,4,7] or [0,2,5], depending on total frame count) — one per VTK panel. A 4D &quot;layer&quot; is not a different or extended data structure; it's a normal ImageLayer whose displayed slice gets swapped from a bigger pre-loaded 4D array." style="text;html=1;align=left;verticalAlign=middle;fontColor=#57678C;fontSize=9.5;" vertex="1" parent="1">
          <mxGeometry x="20" y="240" width="1040" height="50" as="geometry" />
        </mxCell>

        <mxCell id="menu" value="&lt;b&gt;&quot;4D Tools&quot; menu&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Contrast Adjustments &#183; Start MRIDlabels &#183;&lt;br&gt;Gaussian Centers &#183; Get Coordinates &#183; Add View Image&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E2E9F2;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="330" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8FA1C4;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="page4d" target="menu"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="270"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page2controls" name="2 - Shared helpers, duplicated wiring">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="360" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="hdr" value="Not &quot;two independent implementations of everything&quot; — the TOOLS are shared, the WIRING is duplicated" style="text;html=1;align=left;verticalAlign=middle;fontColor=#57678C;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="900" height="20" as="geometry" />
        </mxCell>

        <mxCell id="shared" value="&lt;b&gt;Shared helper classes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;utils.contrast.Contrast&lt;br&gt;utils.zoom.Zoom&lt;br&gt;utils.minimap_handler.Minimap&lt;br&gt;core.paintbrush.Paintbrush&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#0E8C89&quot; style=&quot;font-size:9px&quot;&gt;a fix here applies to BOTH&lt;br&gt;3D and 4D automatically&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2E9F2;strokeColor=#0E8C89;strokeWidth=2;fontColor=#12213D;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="40" width="320" height="180" as="geometry" />
        </mxCell>

        <mxCell id="wire3d" value="&lt;b&gt;ButtonsGUI_3D wiring&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;keyed by VIEW NAME&lt;br&gt;(axial/coronal/sagittal)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wire4d" value="&lt;b&gt;ButtonsGUI_4D wiring&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;keyed by data_index&lt;br&gt;(timepoint PANEL, not view)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="780" y="70" width="280" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0E8C89;strokeWidth=1.75;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="wire3d" target="shared"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0E8C89;strokeWidth=1.75;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="shared" target="wire4d"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="nolink" value="&#10005; NOT a subclass relationship" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C1393E;strokeWidth=1.5;dashed=1;endArrow=none;startArrow=none;fontColor=#C1393E;fontSize=9;fontStyle=1;" edge="1" parent="1" source="wire3d" target="wire4d">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="230"/><mxPoint x="920" y="230"/></Array></mxGeometry>
        </mxCell>

        <mxCell id="fragile" value="Fragility this creates: a fix to HOW a control is wired (a new slider, a new shortcut) needs duplicating into both ButtonsGUI_3D and ButtonsGUI_4D — but a fix to the underlying tool class itself does not." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#C4D0E3;strokeWidth=1.25;fontColor=#57678C;fontSize=10;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="1020" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page3mridtags" name="3 - MRID tags workflow">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="380" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="d1" value="&lt;b&gt;MRID_InputDialog&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px&quot;&gt;tags (name+islands),&lt;br&gt;regions, or load labels.txt&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="30" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="&lt;b&gt;ANAT_InputDialog&lt;/b&gt; (form_index=0)&lt;br&gt;&lt;font style=&quot;font-size:8.5px&quot;&gt;locate/browse or&lt;br&gt;paint &lt;file&gt;-anat.nii.gz&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="260" y="30" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;Paint&lt;/b&gt; (shared Paintbrush)&lt;br&gt;&lt;font style=&quot;font-size:8.5px&quot;&gt;250ms poll gates &quot;Next&quot; until&lt;br&gt;every region has &#8805;1 voxel&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E2E9F2;strokeColor=#0E8C89;strokeWidth=2;fontColor=#12213D;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="500" y="30" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="&lt;b&gt;generate_textfile()&lt;/b&gt;&lt;br&gt;&lt;b&gt;+ save_as_niigz()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px&quot;&gt;&#8594; anat/labels.txt&lt;br&gt;&#8594; &lt;file&gt;-anat.nii.gz&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="760" y="30" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="&lt;b&gt;start_heatmap()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px&quot;&gt;4th VTK panel, hand-rolled&lt;br&gt;jet LUT — NOT via ImageLayer&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8C89;strokeWidth=2;fontColor=#12213D;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1000" y="30" width="140" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8FA1C4;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8FA1C4;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8FA1C4;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0E8C89;strokeWidth=1.75;endArrow=block;endFill=1;" edge="1" parent="1" source="d4" target="d5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="repeat" value="&lt;b&gt;ANAT_InputDialog&lt;/b&gt; (form_index=1) — segmentation/islands pass&lt;br&gt;&lt;font style=&quot;font-size:8.5px&quot;&gt;repeats paint &#8594; generate/save &#8594; heatmap, for &lt;file&gt;-segmentation.nii.gz&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8FA1C4;strokeWidth=1.5;dashed=1;fontColor=#12213D;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="260" y="150" width="460" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="on finish" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8FA1C4;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#57678C;fontSize=9;" edge="1" parent="1" source="d5" target="repeat">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1070" y="120"/></Array></mxGeometry>
        </mxCell>

        <mxCell id="bridge" value="&lt;b&gt;TRANSFORM_InputDialog&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px&quot;&gt;globs transformation-ind_*-to-ind_*.txt&lt;br&gt;&#8594; Gaussian / Electrode Localization&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#C4D0E3;strokeWidth=1.25;dashed=1;fontColor=#8FA1C4;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="780" y="150" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="user Continue?" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8FA1C4;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;fontColor=#57678C;fontSize=9;" edge="1" parent="1" source="repeat" target="bridge"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note" value="One continuous flow inside ONE method (continue_mridtags) — MRID-tag labeling and the Electrode Localization handoff are not separated by any file or module boundary, only by this mid-function branch." style="text;html=1;align=left;verticalAlign=middle;fontColor=#57678C;fontSize=9.5;" vertex="1" parent="1">
          <mxGeometry x="20" y="250" width="1080" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page4boundary" name="4 - Boundary &amp; file outputs">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="380" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="hdr" value="Files this subsystem writes, and where the boundary into Ephys / Electrode Localization sits" style="text;html=1;align=left;verticalAlign=middle;fontColor=#57678C;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="900" height="20" as="geometry" />
        </mxCell>

        <mxCell id="f1" value="&lt;b&gt;anat/labels.txt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px&quot;&gt;ITK-SNAP format&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E2E9F2;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="50" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="&lt;b&gt;&lt;file&gt;-anat.nii.gz&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;file&gt;-segmentation.nii.gz&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E2E9F2;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="270" y="50" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="&lt;b&gt;analysed/&lt;tag&gt;/mrid_barcode-*.pdf&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px&quot;&gt;matplotlib via MplWidget — out of scope&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#C4D0E3;strokeWidth=1.25;dashed=1;fontColor=#8FA1C4;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="560" y="50" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="in4d" value="&lt;b&gt;4D Visualisation &amp; Tools&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;this doc&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E2E9F2;strokeColor=#0E8C89;strokeWidth=2;fontColor=#12213D;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="bridge" value="&lt;b&gt;TRANSFORM_InputDialog&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;the actual boundary&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8FA1C4;strokeWidth=1.5;fontColor=#12213D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="170" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="outephys" value="&lt;b&gt;Electrode Localization / Ephys&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ElectrodeLoc, ephys/visualisation3D.py,&lt;br&gt;Gaussian analysis, barcode plots&lt;br&gt;— separate doc&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#C4D0E3;strokeWidth=1.25;dashed=1;fontColor=#8FA1C4;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="740" y="170" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0E8C89;strokeWidth=1.75;endArrow=block;endFill=1;" edge="1" parent="1" source="in4d" target="bridge"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8FA1C4;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="bridge" target="outephys"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note" value="Not a file or module boundary — a mid-function branch inside continue_mridtags (see sheet 3). Drawn here as a hard line only for clarity of scope, not because the code itself separates cleanly." style="text;html=1;align=left;verticalAlign=middle;fontColor=#57678C;fontSize=9.5;" vertex="1" parent="1">
          <mxGeometry x="20" y="280" width="1040" height="40" as="geometry" />
