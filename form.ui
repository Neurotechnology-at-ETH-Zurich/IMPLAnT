  <action name="actionOpen">
   <property name="text">
    <string>Load MRI Image</string>
   </property>
   <property name="toolTip">
    <string>Open a NIfTI (.nii.gz) file as the main MRI dataset for a new session.</string>
   </property>
  </action>
  <action name="actionAdd">
   <property name="text">
    <string>Add Another Image (3D)</string>
   </property>
  </action>
  <action name="actionSave_Image">
   <property name="text">
    <string>Save Image</string>
   </property>
  </action>
  <action name="actionQuit">
   <property name="text">
    <string>Quit</string>
   </property>
  </action>
  <action name="actionPaintbrush">
   <property name="text">
    <string>Paintbrush</string>
   </property>
   <property name="toolTip">
    <string>Open the paintbrush tool to manually draw or edit a label volume.</string>
   </property>
  </action>
  <action name="actionmain_code_2">
   <property name="text">
    <string>main code 2</string>
   </property>
  </action>
  <action name="actionGaussian_Centers">
   <property name="text">
    <string>Warping and Gaussian Centres Extraction</string>
   </property>
   <property name="toolTip">
    <string>Open warping and Gaussian-centre extraction for electrode localisation.</string>
   </property>
  </action>
  <action name="actionGet_Coordinates">
   <property name="text">
    <string>Final Localization</string>
   </property>
   <property name="toolTip">
    <string>Compute the final electrode localisation from the extracted coordinates.</string>
   </property>
  </action>
  <action name="actionStart_with_Labels">
   <property name="text">
    <string>Start with Labels</string>
   </property>
  </action>
  <action name="actionAddViewImage">
   <property name="text">
    <string>Load Another MRI Image</string>
   </property>
   <property name="toolTip">
    <string>Add another NIfTI file as an overlay layer on top of the current volume.</string>
   </property>
  </action>
  <action name="actionContrast_Adjustments">
   <property name="text">
    <string>Contrast Adjustments</string>
   </property>
   <property name="toolTip">
    <string>Open contrast/brightness controls for 4D data.</string>
   </property>
  </action>
  <action name="actionResample">
   <property name="text">
    <string>Resample</string>
   </property>
   <property name="toolTip">
    <string>Open the resampling controls to change this volume's voxel spacing.</string>
   </property>
  </action>
  <action name="actionRegister">
   <property name="text">
    <string>Registration</string>
   </property>
   <property name="toolTip">
    <string>Open the registration workflow to align this volume to a reference/atlas.</string>
   </property>
  </action>
  <action name="actionContrast_Adjustments_2">
   <property name="text">
    <string>Measurement</string>
   </property>
  </action>
  <action name="actionStart_MRIDlabels">
   <property name="text">
    <string>MRID-tag label creation</string>
   </property>
   <property name="toolTip">
    <string>Open the dialog to define MRID tags and start creating anatomical region labels.</string>
   </property>
  </action>
  <action name="actionOpen_ephys_Data">
   <property name="text">
    <string>Load ephys Data</string>
   </property>
   <property name="toolTip">
    <string>Open a .dat electrophysiology recording (requires a matching .xml file in the same folder).</string>
   </property>
  </action>
  <action name="actionSegmentation">
   <property name="text">
    <string>Segmentation</string>
   </property>
   <property name="toolTip">
    <string>Open the segmentation tool for this volume.</string>
   </property>
  </action>
  <action name="actionGet_Position_in_HPC">
   <property name="text">
    <string>Get Position in HPC</string>
   </property>
  </action>
  <action name="actionMeasurement">
   <property name="text">
    <string>Measurement</string>
   </property>
